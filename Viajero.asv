%% PROBLEMA DEL VIAJERO (guia, secciones 3.1.1, 3.2.1, 3.3 y 3.4.1)
% Ruta abierta: se recorren los 13 municipios una sola vez, sin volver al
% punto de partida, y la ruta puede empezar en cualquiera de ellos.
% Representacion: cada individuo es una fila con una permutacion de 1..13;
% la poblacion es una matriz n x 13 y sus tiempos un vector columna n x 1.
clear; clc;

%% Datos (Tabla I de la guia, minutos; T(i,j) = tiempo de i hacia j)
T = [  0  10  35  29  16  30  40  27  56  44  67  54  81
       6   0  32  31  16  32  34  28  52  44  63  56  83
      34  32   0  29  45  58  35  57  26  73  91  83 110
      29  29  28   0  32  47  57  31  49  61  67  70  99
      18  18  46  33   0  23  52  19  68  39  54  41  69
      30  30  58  46  25   0  46  36  79  39  71  62  90
      40  37  36  59  52  54   0  64  61  80 104  89 117
      32  32  57  32  18  36  65   0  82  50  41  51  82
      55  52  23  48  67  80  56  73   0  95 116 101 130
      47  47  76  62  42  37  73  53  97   0 102  81 111
      79  79 106  80  66  87 110  59 148 101   0  97 100
      59  59  86  74  44  65  90  55 107  80  93   0  29
      89  89 116 104  74  96 119  86 137 110 103  33   0 ];
nombres = {'UCO','Rionegro','La Ceja','El Carmen','Marinilla','Guarne', ...
           'El Retiro','Santuario','La Union','San Vicente','Cocorna', ...
           'El Penol','Guatape'};

%% Parametros
cfg.tamanoPoblacion = 100;        % multiplo de 4 (torneos de 4 y parejas)
cfg.iteraciones     = 100;        % la guia pide 100 en el estudio de seleccion
cfg.seleccion       = 'torneo';   % 'elitismo' | 'torneo' | 'ruleta'
cfg.pm              = 0.2;        % probabilidad de que un hijo mute
cfg.semilla         = 2026;       % prueba r usa la semilla cfg.semilla + r
nPruebas            = 5;          % la guia pide no menos de 5
metodosEstudio      = {'elitismo', 'torneo', 'ruleta'};
iteracionesEstudio  = [10 20 30 50 100 150 200];   % las de la guia
pmEstudio           = [0 0.05 0.1 0.2 0.5 0.8];
carpetaResultados   = fullfile(fileparts(mfilename('fullpath')), 'resultados');

%% Calentamiento: la primera llamada incluye la compilacion de MATLAB (JIT)
% y saldria mas lenta; se descarta para no ensuciar los tiempos medidos.
algoritmoGenetico(cfg, T);
if ~exist(carpetaResultados, 'dir'), mkdir(carpetaResultados); end

%% Estudio 1: metodo de seleccion (100 iteraciones)
tablaSeleccion = table();
for k = 1:numel(metodosEstudio)
    c = cfg;
    c.seleccion = metodosEstudio{k};
    [valores, tiempos, individuos] = correrPruebas(c, T, nPruebas);
    tablaSeleccion = [tablaSeleccion; ...
        resumirPruebas(metodosEstudio{k}, valores, tiempos, individuos)]; %#ok<AGROW>
end
disp(tablaSeleccion);
writetable(tablaSeleccion, fullfile(carpetaResultados, 'viajero_seleccion.csv'));
[~, k] = min(tablaSeleccion.Media);          % criterio: menor promedio
cfg.seleccion = metodosEstudio{k};
fprintf('Seleccion elegida: %s\n', cfg.seleccion);

%% Estudio 2: numero de iteraciones (con la seleccion elegida)
tablaIteraciones = table();
for k = 1:numel(iteracionesEstudio)
    c = cfg;
    c.iteraciones = iteracionesEstudio(k);
    [valores, tiempos, individuos] = correrPruebas(c, T, nPruebas);
    tablaIteraciones = [tablaIteraciones; ...
        resumirPruebas(sprintf('%d iteraciones', c.iteraciones), ...
                       valores, tiempos, individuos)]; %#ok<AGROW>
end
disp(tablaIteraciones);
writetable(tablaIteraciones, fullfile(carpetaResultados, 'viajero_iteraciones.csv'));
% Criterio: menor promedio; si hay empate, min() toma el primero, que es
% la menor cantidad de iteraciones (la lista esta en orden creciente).
[~, k] = min(tablaIteraciones.Media);
cfg.iteraciones = iteracionesEstudio(k);
fprintf('Iteraciones elegidas: %d\n', cfg.iteraciones);

%% Estudio 3: probabilidad de mutacion (seleccion e iteraciones elegidas)
tablaMutacion = table();
historiales = cell(numel(pmEstudio), 1);
for k = 1:numel(pmEstudio)
    c = cfg;
    c.pm = pmEstudio(k);
    [valores, tiempos, individuos, historiales{k}] = correrPruebas(c, T, nPruebas);
    tablaMutacion = [tablaMutacion; ...
        resumirPruebas(sprintf('Pm = %.2f', c.pm), valores, tiempos, individuos)]; %#ok<AGROW>
end
disp(tablaMutacion);
writetable(tablaMutacion, fullfile(carpetaResultados, 'viajero_mutacion.csv'));
[~, k] = min(tablaMutacion.Media);
cfg.pm = pmEstudio(k);
fprintf('Pm elegida: %.2f\n', cfg.pm);

%% Grafica de convergencia de la configuracion final (promedio de las pruebas)
figure('Name', 'Viajero: convergencia');
plot(1:cfg.iteraciones, mean(historiales{k}, 2), 'LineWidth', 1.5);
xlabel('Generacion'); ylabel('Mejor tiempo encontrado (min)'); grid on;
title(sprintf('Viajero: %s, Pm = %.2f, promedio de %d pruebas', ...
              cfg.seleccion, cfg.pm, nPruebas));
saveas(gcf, fullfile(carpetaResultados, 'viajero_convergencia.png'));


%% ===================== FUNCIONES DEL PROBLEMA =====================

function resultado = algoritmoGenetico(cfg, T)
% ALGORITMOGENETICO  Una ejecucion completa del AG para el viajero.
%   cfg: parametros (tamanoPoblacion, iteraciones, seleccion, pm).
%   resultado.mejorValor:     mejor tiempo encontrado en toda la ejecucion.
%   resultado.mejorIndividuo: ruta que lo produjo.
%   resultado.historial:      mejor tiempo acumulado al final de cada generacion.
    assert(mod(cfg.tamanoPoblacion, 4) == 0, 'tamanoPoblacion debe ser multiplo de 4.');

    poblacion = generarPoblacion(cfg.tamanoPoblacion, size(T, 1));
    valores = evaluarPoblacion(poblacion, T);
    [mejorValor, j] = min(valores);
    mejorIndividuo = poblacion(j, :);
    historial = zeros(cfg.iteraciones, 1);

    for iter = 1:cfg.iteraciones
        % 1. Seleccion: mitad de la poblacion como padres
        indices = seleccionar(valores, cfg.seleccion);
        indices = indices(randperm(numel(indices)));   % barajar las parejas
        padres = poblacion(indices, :);
        valoresPadres = valores(indices);

        % 2. Cruce por parejas (1-2, 3-4, ...) y 3. mutacion de cada hijo
        hijos = zeros(size(padres));
        for k = 1:2:size(padres, 1)
            [h1, h2] = cruceOX(padres(k, :), padres(k + 1, :));
            hijos(k, :)     = mutacionViajero(h1, cfg.pm);
            hijos(k + 1, :) = mutacionViajero(h2, cfg.pm);
        end

        % 4. Nueva poblacion: padres + hijos. Solo se evaluan los hijos;
        %    los padres ya tienen su tiempo calculado.
        poblacion = [padres; hijos];
        valores = [valoresPadres(:); evaluarPoblacion(hijos, T)];

        % 5. Mejor historico (con ruleta el mejor puede no ser elegido)
        [mejorGeneracion, j] = min(valores);
        if mejorGeneracion < mejorValor
            mejorValor = mejorGeneracion;
            mejorIndividuo = poblacion(j, :);
        end
        historial(iter) = mejorValor;
    end

    resultado.mejorValor = mejorValor;
    resultado.mejorIndividuo = mejorIndividuo;
    resultado.historial = historial;
end

function [valores, tiempos, individuos, historiales] = correrPruebas(cfg, T, nPruebas)
% CORRERPRUEBAS  Ejecuta el AG nPruebas veces con la misma configuracion.
%   La prueba r usa la semilla cfg.semilla + r: todas las configuraciones
%   arrancan con las mismas poblaciones iniciales y la comparacion es justa.
    valores = zeros(nPruebas, 1);
    tiempos = zeros(nPruebas, 1);
    individuos = zeros(nPruebas, size(T, 1));
    historiales = zeros(cfg.iteraciones, nPruebas);
    for r = 1:nPruebas
        rng(cfg.semilla + r);
        reloj = tic;
        resultado = algoritmoGenetico(cfg, T);
        tiempos(r) = toc(reloj);
        valores(r) = resultado.mejorValor;
        individuos(r, :) = resultado.mejorIndividuo;
        historiales(:, r) = resultado.historial;
    end
end

function poblacion = generarPoblacion(n, nCiudades)
% GENERARPOBLACION  n rutas aleatorias, una por fila (guia 3.2.1).
%   randperm garantiza que ninguna ruta repite municipios.
    poblacion = zeros(n, nCiudades);
    for i = 1:n
        poblacion(i, :) = randperm(nCiudades);
    end
end

function valores = evaluarPoblacion(poblacion, T)
% EVALUARPOBLACION  Tiempo de cada fila de la poblacion (vector columna).
    valores = zeros(size(poblacion, 1), 1);
    for i = 1:size(poblacion, 1)
        valores(i) = calcularTiempoRuta(poblacion(i, :), T);
    end
end

function tiempo = calcularTiempoRuta(ruta, T)
% CALCULARTIEMPORUTA  Minutos para recorrer la ruta en orden, sin regreso.
%   Si la ruta no es una permutacion de 1..13 se suman 10000 minutos de
%   penalizacion (guia 3.1.1): la suma de toda la Tabla I es 9534, asi que
%   una ruta invalida nunca puede quedar mejor que una valida.
    PENALIZACION = 10000;
    n = size(T, 1);
    indexable = isnumeric(ruta) && all(ruta == round(ruta)) && ...
                all(ruta >= 1 & ruta <= n);
    if indexable
        tiempo = 0;
        for i = 2:numel(ruta)
            tiempo = tiempo + T(ruta(i - 1), ruta(i));
        end
    else
        tiempo = sum(T(:));   % ni siquiera se puede recorrer: peor caso
    end
    if ~esValido(ruta, n)
        tiempo = tiempo + PENALIZACION;
    end
end

function valido = esValido(ruta, n)
% ESVALIDO  true si la ruta es una permutacion de 1..n (sin repetir ni faltar).
%   ruta(:)' la vuelve fila, asi funciona igual con filas y con columnas.
    valido = isvector(ruta) && numel(ruta) == n && ...
             isequal(sort(ruta(:)'), 1:n);
end

function [hijo1, hijo2] = cruceOX(padre1, padre2, cortes)
% CRUCEOX  Cruce de orden (Order Crossover, OX) para individuos que son permutaciones.
%   [hijo1, hijo2] = cruceOX(padre1, padre2) elige dos puntos de corte al azar.
%   [hijo1, hijo2] = cruceOX(padre1, padre2, [a b]) usa el tramo a:b (util para probar).
%
%   hijo1: conserva el tramo a:b del padre 1; los huecos se llenan, de izquierda
%          a derecha, con las ciudades que faltan en el orden en que aparecen en
%          el padre 2.
%   hijo2: lo mismo con los papeles invertidos (tramo del padre 2, orden del padre 1).
%
%   Variante: los huecos se llenan de izquierda a derecha. En la version original
%   de Davis (1985) el llenado empieza justo despues del tramo y da la vuelta.


    padre1 = padre1(:)';
    padre2 = padre2(:)';
    n = numel(padre1);

    if nargin < 3
        cortes = sort(randperm(n, 2));
    end
    a = cortes(1);
    b = cortes(2);

    hijo1 = construirHijo(padre1, padre2, a, b);
    hijo2 = construirHijo(padre2, padre1, a, b);
end

function hijo = construirHijo(base, otro, a, b)
    n = numel(base);
    hijo = zeros(1, n);
    tramo = base(a:b);
    hijo(a:b) = tramo;

    restantes = otro(~ismember(otro, tramo));
    huecos = [1:a-1, b+1:n];
    hijo(huecos) = restantes;
end

function ruta = mutacionViajero(ruta, pm)
% MUTACIONVIAJERO  Con probabilidad pm intercambia dos posiciones al azar (guia 3.4.1).
%   El resultado sigue siendo una permutacion valida.
    if rand() < pm
        posiciones = randperm(numel(ruta), 2);       % dos posiciones distintas
        ruta(posiciones) = ruta(fliplr(posiciones)); % intercambio
    end
end
